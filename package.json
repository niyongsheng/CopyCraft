{
  "name": "copycraft",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "CopyCraft 字帖工坊 — 支持 Web、macOS 与 Windows 的字帖生成器",
  "author": "CopyCraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niyongsheng/CopyCraft.git"
  },
  "homepage": "https://copycraft.looplooptech.com/",
  "bugs": {
    "url": "https://github.com/niyongsheng/CopyCraft/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on tcp:5178 && cross-env VITE_DEV_SERVER_URL=http://localhost:5178 electron .\"",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "start:desktop": "electron .",
    "pack:desktop": "npm run build:web && electron-builder --dir",
    "dist:mac": "npm run build:web && electron-builder --mac --publish never",
    "dist:win": "npm run build:web && electron-builder --win --publish never",
    "icons": "node scripts/make-icons.mjs",
    "dist:win:zip": "npm run build:web && electron-builder --win zip --x64 --publish never",
    "license:gen": "node scripts/gen-license.cjs",
    "license:fp": "node scripts/gen-license.cjs --local",
    "test:license": "node --test tests/license.test.cjs"
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "@aptabase/web": "^0.5.0",
    "docx": "^9.13.0",
    "electron-updater": "^6.8.11",
    "hanzi-writer": "^3.7.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^9.5.1"
  }
}
